# Адрес сайта для canonical и Open Graph, например https://vyra.example
NEXT_PUBLIC_SITE_URL=

# E-mail для заявок: показывается в контактах и как запасной канал, если форма не отправила.
NEXT_PUBLIC_CONTACT_EMAIL=

# Мессенджеры для кнопки в правом нижнем углу. Пусто — пункт не показывается.
# Например: https://t.me/имя, https://wa.me/79990000000, ссылка-приглашение MAX.
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_MAX_URL=

# Приём заявок через Telegram-бота (FORMS_SETUP.md). Пусто — форма отвечает «приём не настроен».
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
